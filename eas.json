{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "rustore-aab": {
      "environment": "production",
      "distribution": "store",
      "credentialsSource": "local",
      "autoIncrement": true,
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
